@startuml use-case
' Діаграма прецедентів: дві ролі — читач (client.html) і бібліотекар (admin.html)

left to right direction
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam actorBorderColor #333333
skinparam actorBackgroundColor white
skinparam usecaseBorderColor #333333
skinparam usecaseBackgroundColor #F7F9FC
skinparam rectangleBorderColor #333333
skinparam ArrowFontSize 11
skinparam ArrowFontColor #444444
skinparam linetype polyline
skinparam nodesep 16
skinparam ranksep 70

actor "Читач" as Reader
actor "Бібліотекар" as Librarian

rectangle "Вебзастосунок бібліотеки коледжу" {
  usecase "Переглянути\nкаталог книг" as UC1
  usecase "Знайти, фільтрувати,\nсортувати книги" as UC2
  usecase "Подати заявку\nна книгу" as UC3
  usecase "Переглянути\nстатус заявок" as UC4

  usecase "Розглянути заявку:\nсхвалити / відхилити" as UC5
  usecase "Видати книгу" as UC6
  usecase "Прийняти\nповернення" as UC7
  usecase "Керувати каталогом\n(додати, змінити, видалити)" as UC8
  usecase "Керувати\nчитачами" as UC9

  usecase "Перевірити\nвведені дані" as CHK_INPUT
  usecase "Перевірити наявність\nвільного примірника" as CHK_AVAIL
  usecase "Перевірити допустимий\nперехід статусу" as CHK_STATE
  usecase "Перевірити\nнезавершені заявки" as CHK_ACTIVE
}

Reader --> UC1
Reader --> UC3
Reader --> UC4
UC1 <.. UC2 : <<extend>>

UC3 ..> CHK_INPUT : <<include>>
UC3 ..> CHK_AVAIL : <<include>>

UC5 <-- Librarian
UC6 <-- Librarian
UC7 <-- Librarian
UC8 <-- Librarian
UC9 <-- Librarian

CHK_STATE <.. UC5 : <<include>>
CHK_STATE <.. UC6 : <<include>>
CHK_STATE <.. UC7 : <<include>>
CHK_AVAIL <.. UC5 : <<include>>
CHK_INPUT <.. UC8 : <<include>>
CHK_INPUT <.. UC9 : <<include>>
CHK_ACTIVE <.. UC8 : <<include>>
CHK_ACTIVE <.. UC9 : <<include>>

@enduml
